{
  "name": "@cnwhy/base64",
  "version": "0.2.8",
  "description": "Base64 library, lossless transcoding.",
  "main": "dist/Base64.umd.js",
  "module": "dist/Base64.es.js",
  "types": "lib/Base64.d.ts",
  "scripts": {
    "clean": "rimraf dist/* lib/*",
    "precompile": "npm run clean",
    "compile": "tsc && rollup -c",
    "build": "npm run compile",
    "test": "ava test/index.js",
    "test-cov": "nyc npm test --fail-fast",
    "verify": "npm run compile && npm test"
  },
  "keywords": [
    "base64",
    "lossless",
    "atob",
    "btoa"
  ],
  "files": [
    "README.md",
    "lib",
    "dist"
  ],
  "author": "cnwhy",
  "license": "MIT",
  "devDependencies": {
    "@babel/preset-env": "^7.4.3",
    "@types/benchmark": "^1.0.31",
    "ava": "^1.4.1",
    "benchmark": "^2.1.4",
    "gbk.js": "^0.2.4",
    "nyc": "^18.0.0",
    "rimraf": "^2.6.3",
    "rollup": "^1.10.1",
    "rollup-plugin-babel": "^4.3.2",
    "rollup-plugin-terser": "^5.0.0",
    "rollup-plugin-typescript": "^1.0.1",
    "rollup-plugin-uglify": "^6.0.2",
    "ts-node": "^8.1.0",
    "tslib": "^1.10.0",
    "typescript": "^5.4.5"
  },
  "directories": {
    "test": "test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cnwhy/Base64.js.git"
  },
  "bugs": {
    "url": "https://github.com/cnwhy/Base64.js/issues"
  },
  "homepage": "https://github.com/cnwhy/Base64.js#readme",
  "ava": {
    "compileEnhancements": false,
    "extensions": [
      "ts"
    ],
    "require": [
      "ts-node/register"
    ]
  },
  "nyc": {
    "include": [
      "src/*.ts"
    ],
    "exclude": [
      "**/*.d.ts"
    ],
    "extension": [
      ".ts"
    ],
    "require": [
      "ts-node/register"
    ],
    "reporter": [
      "html",
      "text-summary"
    ],
    "sourceMap": true,
    "instrument": true
  }
}
