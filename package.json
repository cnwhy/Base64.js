{
  "name": "@cnwhy/base64",
  "version": "1.0.0",
  "description": "Base64 library, lossless transcoding.",
  "main": "./dist/Base64.umd.js",
  "module": "./dist/Base64.es.mjs",
  "browser": "./dist/Base64.es.mjs",
  "types": "./types/main.d.ts",
  "unpkg": "./dist/Base64.umd.min.js",
  "jsdelivr": "./dist/Base64.umd.min.js",
  "exports": {
    ".": {
      "types": "./types/main.d.ts",
      "import": "./dist/Base64.es.mjs",
      "require": "./dist/Base64.umd.js",
      "default": "./dist/Base64.es.mjs"
    }
  },
  "sideEffects": false,
  "scripts": {
    "clean": "rimraf dist/* types/* lib/*",
    "precompile": "npm run clean",
    "compile": "tsc --emitDeclarationOnly --declarationDir types && rollup -c",
    "build": "npm run compile",
    "prepublishOnly": "npm run build",
    "test": "ava test/index.js",
    "test-cov": "npm run compile && c8 --reporter=text --reporter=html ava test/index.js --fail-fast",
    "verify": "npm run compile && npm test"
  },
  "keywords": [
    "base64",
    "lossless",
    "atob",
    "btoa"
  ],
  "files": [
    "README.md",
    "dist",
    "types"
  ],
  "author": "cnwhy",
  "license": "MIT",
  "devDependencies": {
    "@babel/preset-env": "^7.4.3",
    "@types/benchmark": "^1.0.31",
    "ava": "^8.0.1",
    "benchmark": "^2.1.4",
    "c8": "^10.1.3",
    "gbk.js": "^0.2.4",
    "nyc": "^18.0.0",
    "rimraf": "^2.6.3",
    "rollup": "^2.80.0",
    "rollup-plugin-babel": "^4.3.2",
    "rollup-plugin-terser": "^5.0.0",
    "rollup-plugin-typescript": "^1.0.1",
    "ts-node": "^8.1.0",
    "tslib": "^1.10.0",
    "typescript": "^5.4.5"
  },
  "directories": {
    "test": "test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cnwhy/Base64.js.git"
  },
  "bugs": {
    "url": "https://github.com/cnwhy/Base64.js/issues"
  },
  "homepage": "https://github.com/cnwhy/Base64.js#readme",
  "ava": {
    "compileEnhancements": false,
    "extensions": [
      "ts"
    ],
    "require": [
      "ts-node/register/index.js"
    ]
  }
}
